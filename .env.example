# Copy to .env and edit. Values here are only read if not already exported.

# ---- Planner brain: DeepSeek (OpenAI-compatible, text) ----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1024

# ---- Vision judge: Kimi (Moonshot) multimodal API (OpenAI-compatible) ----
# DeepSeek has no vision endpoint, so photo-judging uses Kimi.
# Provide the Kimi key via VISION_API_KEY or MOONSHOT_API_KEY (either works).
VISION_BASE_URL=https://api.moonshot.cn/v1
VISION_API_KEY=
MOONSHOT_API_KEY=sk-your-kimi-key
# Vision models: moonshot-v1-8k/32k/128k-vision-preview, kimi-k3, kimi-k2.6 ...
VISION_MODEL=moonshot-v1-8k-vision-preview
# Kimi advises not fixing temperature; -1 = don't send it.
VISION_TEMPERATURE=-1
VISION_MAX_TOKENS=384

# ---- Camera ----
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_WARMUP=8
CAPTURE_DIR=captures

# ---- Flashlight tool (flashlight.py over ADB) ----
FLASHLIGHT_SCRIPT=/home/truthg/light/flashlight.py
FLASHLIGHT_PYTHON=python3

# ---- Agent ----
AGENT_MAX_STEPS=12
